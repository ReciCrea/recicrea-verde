  <div class="card" style="max-width:780px;margin:0 auto;text-align:center;padding:clamp(24px,5vw,42px)">
   <div class="card-icon">💚</div>
   <h3>Apoya nuestro proyecto</h3>
      <div class="gfm-embed" data-url="https://www.gofundme.com/f/recicrea-verde-un-futuro-con-menos-residuos/widget/large?attribution_id=sl%3A9f4c1269-ae85-45d1-91d7-22af13260f1d"></div><script defer src="https://www.gofundme.com/static/js/embed.js"></script>
      
