<script>
const ideas=[
 {name:"Portalápices de cartón",cat:"manualidad",emoji:"✏️",materials:"Tubo de cartón",desc:"Crea un organizador para lápices con un tubo y una base de cartón."},
 {name:"Organizador con una caja",cat:"hogar",emoji:"📦",materials:"Caja de cartón",desc:"Adapta una caja limpia para ordenar cajones, cables o accesorios."},
 {name:"Tarro para guardar botones",cat:"hogar",emoji:"🫙",materials:"Tarro de vidrio",desc:"Reutiliza un tarro limpio para guardar pequeños objetos."},
 {name:"Maceta reutilizada",cat:"jardin",emoji:"🪴",materials:"Recipiente resistente",desc:"Da una segunda vida a un recipiente adecuado para cultivar plantas."},
 {name:"Envoltorio de regalo",cat:"manualidad",emoji:"🎁",materials:"Papel usado",desc:"Envuelve regalos con papel de revistas o embalaje que conserves."},
 {name:"Separadores de libros",cat:"manualidad",emoji:"📚",materials:"Cartón fino",desc:"Recorta tiras de cartón y decóralas con dibujos o papel reutilizado."},
 {name:"Caja para cables",cat:"hogar",emoji:"🔌",materials:"Caja pequeña",desc:"Organiza cargadores y cables con una caja firme y etiquetas."},
 {name:"Etiquetas para plantas",cat:"jardin",emoji:"🌿",materials:"Cartón resistente",desc:"Haz etiquetas temporales para identificar tus plantas y semilleros."},
 {name:"Collage de revistas",cat:"manualidad",emoji:"🎨",materials:"Revistas viejas",desc:"Crea una lámina artística recortando imágenes y colores."},
 {name:"Bolsa para reutilizar",cat:"hogar",emoji:"🛍️",materials:"Bolsa resistente",desc:"Guarda una bolsa reutilizable junto a tus llaves para acordarte de llevarla."},
 {name:"Papel de notas",cat:"hogar",emoji:"📝",materials:"Papel usado por una cara",desc:"Aprovecha las hojas impresas por una sola cara para apuntes."},
 {name:"Mini jardín de hierbas",cat:"jardin",emoji:"🌱",materials:"Macetas o recipientes adecuados",desc:"Cultiva hierbas aromáticas en recipientes limpios con drenaje adecuado."}
];
const results=document.getElementById('results'),input=document.getElementById('searchInput'),category=document.getElementById('category'),count=document.getElementById('resultCount');
function render(list){results.innerHTML='';count.textContent=list.length+' '+(list.length===1?'idea encontrada':'ideas encontradas');if(!list.length){results.innerHTML='<div class="empty">No encontramos ideas con esos filtros. Prueba con otra palabra o categoría.</div>';return;}list.forEach(i=>{const el=document.createElement('article');el.className='idea';el.innerHTML='<div class="emoji">'+i.emoji+'</div><h3></h3><p></p><div class="meta"></div>';el.querySelector('h3').textContent=i.name;el.querySelector('p').textContent=i.desc;el.querySelector('.meta').textContent='Material: '+i.materials;results.appendChild(el);});}
function filter(){const q=input.value.trim().toLocaleLowerCase('es');const c=category.value;render(ideas.filter(i=>(c==='todas'||i.cat===c)&&[i.name,i.materials,i.desc].some(v=>v.toLocaleLowerCase('es').includes(q))));}
input.addEventListener('input',filter);category.addEventListener('change',filter);document.getElementById('randomBtn').addEventListener('click',()=>{const pool=ideas.filter(i=>category.value==='todas'||i.cat===category.value);const chosen=pool[Math.floor(Math.random()*pool.length)];input.value=chosen.materials;filter();});
const menuBtn=document.getElementById('menuBtn'),nav=document.getElementById('nav');menuBtn.addEventListener('click',()=>{const open=nav.classList.toggle('open');menuBtn.setAttribute('aria-expanded',String(open));menuBtn.textContent=open?'×':'☰';});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menuBtn.setAttribute('aria-expanded','false');menuBtn.textContent='☰';}));document.getElementById('year').textContent=new Date().getFullYear();render(ideas);
</script>
